# PORT: The port that Express web server listens on (default 3000)
PORT=3000

# NODE_ENV: Application runtime mode (development / production)
NODE_ENV=production

# DOMAIN: Your custom domain name on VDS (e.g., messenger.example.com)
DOMAIN=messenger.example.com

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY=

# APP_URL: The public HTTPS URL where this applet is hosted
APP_URL=https://messenger.example.com
